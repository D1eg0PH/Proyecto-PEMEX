<Window x:Class="WpfApp2.IngresarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar Contraseña" Height="150" Width="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Contraseña:" Grid.Row="0" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtContrasena" Grid.Row="1" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar" Click="BtnAceptar_Click" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancelar" Click="BtnCancelar_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>