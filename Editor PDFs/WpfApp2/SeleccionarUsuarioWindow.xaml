<Window x:Class="WpfApp2.SeleccionarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Usuario" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LISTA DE USUARIOS -->

        <ListBox x:Name="lstUsuarios" Grid.Row="0" Margin="0,0,0,15">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Rol}" Foreground="Gray" Grid.Column="1"/>

                        <!-- BOTÓN EDITAR -->
                        <Button Content="Editar" 
                        Tag="{Binding}" 
                        Click="BtnEditarUsuario_Click" 
                        Grid.Column="2" 
                        Width="60" 
                        Margin="5,0"/>

                        <!-- BOTÓN ELIMINAR -->
                        <Button Content="Eliminar" 
                        Tag="{Binding}" 
                        Click="BtnEliminarUsuario_Click" 
                        Grid.Column="3" 
                        Width="60" 
                        Margin="5,0"
                        Background="LightCoral"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- BOTÓN AGREGAR -->
        <Button Content="Agregar Nuevo Usuario" 
                Click="BtnAgregarUsuario_Click" 
                Grid.Row="1" 
                Width="180" 
                Height="35" 
                FontWeight="Bold" 
                Margin="0,0,0,10"/>

        <!-- BOTONES ACEPTAR/CANCELAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar" Click="BtnAceptar_Click" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancelar" Click="BtnCancelar_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>