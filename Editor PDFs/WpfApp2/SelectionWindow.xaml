<Window x:Class="WpfApp2.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecciona Función" Height="200" Width="300"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="¿Qué deseas hacer?" FontSize="16" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Button Name="BtnEditar" Content="Editar PDF" Click="BtnEditar_Click" Margin="0,0,0,10" Padding="10"/>
            <Button Name="BtnAst" Content="Generar AST" Click="BtnAst_Click" Padding="10"/>
        </StackPanel>
    </Grid>
</Window>