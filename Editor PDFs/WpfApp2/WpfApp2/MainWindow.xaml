<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor Básico de PDF" Height="700" Width="1000"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <ToolBar Grid.Row="0" Height="40">
            <Button Content="Abrir PDF" Click="BtnOpenPdf_Click" Margin="2"/>
            <Separator/>
            <Button Content="Insertar Texto" Click="BtnAddText_Click" Margin="2"/>
            <Button Content="Insertar Firma" Click="BtnAddSignature_Click" Margin="2"/>
            <Separator/>
            <Button Content="Guardar PDF" Click="BtnSavePdf_Click" Margin="2"/>
            <Separator/>
            <TextBlock Text="Página:" VerticalAlignment="Center" Margin="10,0"/>
            <ComboBox x:Name="cmbPages" Width="80" SelectionChanged="CmbPages_SelectionChanged"/>
        </ToolBar>

        <!-- Área de edición -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="editCanvas" Background="White" MouseLeftButtonDown="EditCanvas_MouseLeftButtonDown">
                <Image x:Name="pdfPageImage" Stretch="None"/>
            </Canvas>
        </ScrollViewer>

        <!-- Panel de propiedades de texto -->
        <Grid Grid.Row="2" Background="#f0f0f0" Visibility="Collapsed" x:Name="textPropertiesPanel">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Fuente:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbFontFamily" Width="120" SelectedIndex="0" Margin="0,0,10,0"/>
                <TextBlock Text="Tamaño:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbFontSize" Width="60" SelectedIndex="4" Margin="0,0,10,0"/>
                <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbFontColor" Width="100" SelectedIndex="0" Margin="0,0,10,0"/>
                <Button Content="Aceptar" Click="BtnAcceptText_Click" Margin="5,0"/>
                <Button Content="Cancelar" Click="BtnCancelText_Click" Margin="5,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>